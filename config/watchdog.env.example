# /etc/mesh-gateway/watchdog.env  (chmod 600, root-owned)
#
# Read by host/mesh-uplink-watchdog.sh. Without HC_PING_URL the watchdog still
# detects and repairs, but only to the journal — nothing pages you, and a
# silently self-healing gateway is indistinguishable from one that never broke.
#
# Works with hosted healthchecks.io or a self-hosted instance; the ping path
# differs between them:
#   hosted:       https://hc-ping.com/<uuid>
#   self-hosted:  http://<host>:<port>/ping/<uuid>
#
# The script appends /start before a repair and /fail if the repair does not
# take, so set the check's period to the timer interval (10m) and give it a
# grace long enough to cover a repair (15m).
HC_PING_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# Optional overrides:
#   WINDOW=15m        how far back to look in the container logs
#   RADIO_MAX=3600    seconds of radio silence before the gateway is suspect
