# Copy to .env and fill in. Do not commit .env.

# The node's Bluetooth MAC. Pair it once first (host/pair-node.exp), then put it
# here. `bluetoothctl devices` lists paired devices with their addresses.
NODE_BLE_MAC=AA:BB:CC:DD:EE:FF

# Exact origin your web client is served from, e.g. https://your-client.example.com
# Comma-separated for several. "*" works and lets any page drive your radio.
ALLOW_ORIGINS=*

# Only needed with the with-meshmonitor profile.
SESSION_SECRET=
MESHMONITOR_ORIGINS=
