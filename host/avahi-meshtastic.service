<?xml version="1.0" standalone="no"?><!--*-nxml-*-->
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Publishes the ble-bridge's TCP port for the Meshtastic mobile apps'
     network auto-discovery. Deployed to /etc/avahi/services/. -->
<service-group>
  <name replace-wildcards="yes">Meshtastic Node (%h)</name>
  <service>
    <type>_meshtastic._tcp</type>
    <port>4403</port>
  </service>
</service-group>
